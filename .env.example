# Copy to .env and fill in. Never commit .env.

# Which AI runs Life OS. Only one is ever active: claude or gemini.
# You can also switch live with:  POST /provider {"provider": "gemini"}
LIFEOS_PROVIDER=claude

# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Model for the agent. Sonnet is cheaper for everyday loops; Opus for the weekly review.
LIFEOS_MODEL=claude-sonnet-5-5
LIFEOS_MODEL_DEEP=claude-opus-5-5

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Model for the weekly review; set a Pro model here if your key has access.
GEMINI_MODEL_DEEP=gemini-3.7-flash

# Home Assistant: URL and a long-lived access token (Profile > Security > Long-lived tokens)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Notifications go straight to the Life OS app on each phone (turn on in the app: Settings > Notifications).
# Contact address sent to Google's push service with each notification (required by the standard).
LIFEOS_PUSH_CONTACT=mailto:you@example.com

# Optional extra channel: the ntfy app (self-host it, or use ntfy.sh with a long random topic).
# Leave NTFY_TOPIC empty to use only the app's own notifications.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# The https address your phones use to reach Life OS. The phone app, Google sign-in and the
# Approve / Reject buttons all use it. Easiest: Tailscale (see README), e.g.
#   https://lifeos-box.tail1234.ts.net
LIFEOS_PUBLIC_URL=https://lifeos-box.your-tailnet.ts.net

# Household key: typed once on each phone to sign in to the app, and used by scripts,
# Home Assistant and NFC calls (header X-LifeOS-Key). Make it long; a 4-word phrase works.
LIFEOS_API_KEY=change-me
# Secret used to sign approve/reject links and app sign-ins (24+ random characters).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it signs every phone out (do this if a phone is lost).
LIFEOS_SIGNING_SECRET=change-me-too

# Google sign-in: an OAuth client of type "Web application" (see README). Each person's token is
# saved next to GOOGLE_TOKEN_FILE as google_token_<person>.json when they connect in the app.
GOOGLE_CLIENT_SECRET_FILE=secrets/client_secret.json
GOOGLE_TOKEN_FILE=secrets/google_token.json
GOOGLE_FAMILY_CALENDAR_ID=primary

# Safety net on AI costs: at most this many AI requests per day (app, routines and tags together).
LIFEOS_MAX_RUNS_PER_DAY=150

LIFEOS_DB=data/lifeos.db
LIFEOS_TZ=Europe/London
